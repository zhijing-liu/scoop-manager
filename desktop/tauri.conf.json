{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scoop Manager",
  "version": "1.2.0",
  "identifier": "com.scoopmanager.desktop",
  "build": {
    "frontendDist": "ui",
    "beforeDevCommand": "bun run desktop:ui",
    "beforeBuildCommand": "bun run desktop:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/scoop-manager"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
